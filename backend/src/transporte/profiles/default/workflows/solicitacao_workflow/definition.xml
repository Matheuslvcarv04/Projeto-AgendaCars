<?xml version="1.0" encoding="utf-8"?>
<dc-workflow workflow_id="solicitacao_workflow"
             title="Workflow de solicitação de transporte"
             description="Decisão do gestor sobre solicitações de transporte."
             state_variable="review_state"
             initial_state="pendente">
             
  <state state_id="pendente" title="Pendente">
    <description>Solicitação aguardando decisão do gestor.</description>
    <exit-transition transition_id="aprovar" />
    <exit-transition transition_id="recusar" />
    <permission-map name="View" acquired="False">
      <permission-role>Manager</permission-role>
      <permission-role>Administrador</permission-role>
      <permission-role>Owner</permission-role>
    </permission-map>
    <permission-map name="Modify portal content" acquired="False">
      <permission-role>Manager</permission-role>
      <permission-role>Administrador</permission-role>
      <permission-role>Owner</permission-role>
    </permission-map>
  </state>
  <state state_id="aprovada" title="Aprovada">
    <description>Solicitação aprovada e convertida em viagem.</description>
    <permission-map name="View" acquired="False">
      <permission-role>Manager</permission-role>
      <permission-role>Administrador</permission-role>
      <permission-role>Owner</permission-role>
    </permission-map>
  </state>
  <state state_id="recusada" title="Recusada">
    <description>Solicitação recusada pelo gestor.</description>
    <permission-map name="View" acquired="False">
      <permission-role>Manager</permission-role>
      <permission-role>Administrador</permission-role>
      <permission-role>Owner</permission-role>
    </permission-map>
  </state>

  <transition transition_id="aprovar" title="Aprovar" new_state="aprovada" trigger="USER" before_script="" after_script="">
    <description>Aprova a solicitação e cria automaticamente a viagem.</description>
    <guard>
      <guard-permission>Manage portal</guard-permission>
    </guard>
  </transition>
  <transition transition_id="recusar" title="Recusar" new_state="recusada" trigger="USER" before_script="" after_script="">
    <description>Recusa a solicitação.</description>
    <guard>
      <guard-permission>Manage portal</guard-permission>
    </guard>
  </transition>

</dc-workflow>
