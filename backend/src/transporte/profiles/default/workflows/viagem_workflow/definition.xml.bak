<?xml version="1.0" encoding="utf-8"?>
<dc-workflow workflow-definition="viagem_workflow"
             xmlns="http://namespaces.zope.org/dc-workflow">
  <meta>
    <title>Viagem restrita</title>
    <description>Restringe cada viagem ao solicitante, motorista designado e administrador.</description>
  </meta>
  <state state_id="restrita" title="Restrita">
    <permission-map name="View" acquired="False">
      <permission-role>Manager</permission-role>
      <permission-role>Owner</permission-role>
      <permission-role>MotoristaAtribuido</permission-role>
    </permission-map>
    <permission-map name="Modify portal content" acquired="False">
      <permission-role>Manager</permission-role>
    </permission-map>
    <permission-map name="Update checklist" acquired="False">
      <permission-role>Manager</permission-role>
      <permission-role>MotoristaAtribuido</permission-role>
    </permission-map>
  </state>
  <variable variable_id="review_state" for_catalog="True" update_always="True">
    <default>restrita</default>
    <guard-permission>Manage portal</guard-permission>
  </variable>
</dc-workflow>
