<?xml version="1.0" encoding="utf-8"?>
<dc-workflow workflow-definition="privileged_content_workflow"
             xmlns="http://namespaces.zope.org/dc-workflow">
  <meta>
    <title>Conteúdo administrativo restrito</title>
    <description>Restringe cadastros e históricos ao administrador.</description>
  </meta>
  <state state_id="privado" title="Privado">
    <description>Conteúdo sigiloso acessível somente ao administrador.</description>
    <permission-map name="View" acquired="False">
      <permission-role>Manager</permission-role>
    </permission-map>
    <permission-map name="Modify portal content" acquired="False">
      <permission-role>Manager</permission-role>
    </permission-map>
    <permission-map name="Delete objects" acquired="False">
      <permission-role>Manager</permission-role>
    </permission-map>
  </state>
  <variable variable_id="review_state" for_catalog="True" update_always="True">
    <default>privado</default>
    <guard-permission>Manage portal</guard-permission>
  </variable>
</dc-workflow>
