<?xml version="1.0" encoding="utf-8"?>
<dc-workflow workflow_id="privileged_content_workflow"
             title="Conteudo administrativo restrito"
             description="Restringe cadastros e historicos ao administrador."
             state_variable="review_state"
             initial_state="privado">
  <state state_id="privado" title="Privado">
    <description>Conteúdo sigiloso acessível somente ao administrador.</description>
    <permission-map name="View" acquired="False">
      <permission-role>Manager</permission-role>
      <permission-role>Administrador</permission-role>
    </permission-map>
    <permission-map name="Modify portal content" acquired="False">
      <permission-role>Manager</permission-role>
      <permission-role>Administrador</permission-role>
    </permission-map>
    <permission-map name="Delete objects" acquired="False">
      <permission-role>Manager</permission-role>
      <permission-role>Administrador</permission-role>
    </permission-map>
  </state>
</dc-workflow>
